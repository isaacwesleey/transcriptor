# Configuración de Transcriptor
# Copia este archivo a .env y configura tus valores

# OpenAI API Key (REQUERIDO)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Configuración de caché (OPCIONAL)
CACHE_ENABLED=true
CACHE_DIR=.cache/transcriptions

# Configuración de logging (OPCIONAL)
LOG_LEVEL=INFO
LOG_FILE=transcriptor.log

# Configuración de procesamiento (OPCIONAL)
DEFAULT_CHUNK_MINUTES=5
MAX_RETRY_ATTEMPTS=5

# Configuración de resumen con IA (OPCIONAL)
# Modelo a usar para generar resúmenes automáticos
# Opciones: gpt-4o-mini (más económico), gpt-4o, gpt-4
SUMMARY_MODEL=gpt-4o-mini
